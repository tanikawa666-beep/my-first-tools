# ─── OpenAI ───────────────────────────────────────────────
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── NCBI (PubMed) ────────────────────────────────────────
# https://www.ncbi.nlm.nih.gov/account/ で取得（無料・任意だがレート制限緩和のため推奨）
NCBI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 検索キーワード（カンマ区切り、4〜5個推奨） ──────────────
# 例: 循環器・腫瘍・神経科学・糖尿病・AI医療など
PUBMED_KEYWORDS=machine learning clinical medicine,randomized controlled trial oncology,heart failure treatment,neurology stroke,diabetes mellitus treatment

# ─── メール設定（Gmail 推奨） ──────────────────────────────
# 送信元アドレス（Gmailの場合はGoogleアカウントのメールアドレス）
EMAIL_FROM=your-gmail@gmail.com

# 送信先アドレス（受信したいスマホのメールアドレス）
EMAIL_TO=your-email@example.com

# Gmailの「アプリパスワード」（16桁）
# 取得方法: Googleアカウント → セキュリティ → 2段階認証ON → アプリパスワード
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# SMTPサーバー設定（Gmailの場合はデフォルトのままでOK）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
